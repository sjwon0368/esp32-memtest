# ---------------------------------------------------------------------------
# Target-specific defaults for esp32 builds (classic ESP32, quad PSRAM).
# ---------------------------------------------------------------------------

# --- PSRAM ----------------------------------------------------------
# This is the single most important setting for a memory tester: with
# MALLOC_CAP_SPIRAM unusable, the ESP-IDF heap refuses to hand out PSRAM
# and there is nothing to test.  esp32-memtest prints a loud warning when
# this is disabled.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# Do not waste PSRAM on small allocations, keep it for the test pool.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Leave internal RAM for the IDF runtime, the console and the test pool.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
# A memory tester must be able to boot on a board whose PSRAM is absent or
# wired wrong, otherwise it cannot report anything at all: without this the
# ESP-IDF startup panics in a reboot loop before app_main() ever runs.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

